# Telegram Bot Token from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyZ

# Telegram User ID of the admin (Numerical ID)
ADMIN_ID=123456789

# Optional Remove.bg API key. If left empty, the bot uses local rembg processing.
REMOVEBG_API_KEY=

# Maximum allowed file size in MB (Default: 20)
MAX_FILE_SIZE_MB=20

# Web server port for Render deployment (Default: 8080)
PORT=8080
